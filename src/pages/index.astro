---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapTool from '../components/tools/MapTool.astro';
import AffordTool from '../components/tools/AffordTool.astro';
import LoanTool from '../components/tools/LoanTool.astro';
import UnitPriceTool from '../components/tools/UnitPriceTool.astro';
import CapgainTool from '../components/tools/CapgainTool.astro';
import '../styles/calc.css';

const base = 'https://tools.salahome.tw';
const author = { '@type': 'RealEstateAgent', name: '蔡莎拉', url: 'https://www.salahome.tw' };
// 給搜尋引擎看的工具清單（頁面上不顯示，網站也沒有目錄）
const tools = [
  { id: 'fengming-map', name: '鳳鳴重劃區生活地圖', category: 'UtilitiesApplication', desc: '鳳鳴重劃區的社區與新建案、賣場與便利商店、火車站、捷運站、公車站、交流道、微笑單車與學校，距離與步行時間一次看。' },
  { id: 'afford', name: '購屋能力試算', category: 'FinanceApplication', desc: '輸入月收入與自備款，估算買得起多少總價，同時考慮月付金負擔與貸款成數。' },
  { id: 'loan', name: '房貸月付金試算', category: 'FinanceApplication', desc: '輸入貸款金額、利率、年限與寬限期，算出每月要繳多少、總利息多少。' },
  { id: 'unit-price', name: '房屋單價計算機', category: 'FinanceApplication', desc: '總價換算每坪單價，含車位、扣車位、室內、主建物各種口徑，並反算總價。' },
  { id: 'capgain', name: '房地合一稅試算', category: 'FinanceApplication', desc: '輸入售價、成本、持有期間，試算個人房地合一稅 2.0 的稅額與自住優惠。' },
];
---
<BaseLayout title="蔡莎拉的工具箱">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${base}/#page`,
        url: `${base}/`,
        name: '蔡莎拉的工具箱｜鳳鳴買房賣房免費工具',
        inLanguage: 'zh-Hant',
        author,
        mainEntity: { '@id': `${base}/#toollist` },
      },
      {
        '@type': 'ItemList',
        '@id': `${base}/#toollist`,
        numberOfItems: tools.length,
        itemListElement: tools.map((t, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'WebApplication',
            name: t.name,
            url: `${base}/#${t.id}`,
            description: t.desc,
            applicationCategory: t.category,
            operatingSystem: 'Web',
            isAccessibleForFree: true,
            inLanguage: 'zh-Hant',
            author,
          },
        })),
      },
    ],
  })} />

  <div class="hero">
    <div class="container hero-inner">
      <p class="hero-kicker">免費・免註冊・不留個資</p>
      <h1>買房、賣房前，<br />先自己算一遍</h1>
      <p class="hero-sub">
        鶯歌・鳳鳴在地房仲蔡莎拉，把客戶最常問的問題做成工具。往下滑，一項一項用。
      </p>
      <div class="hero-who">
        <img src="/images/brand/sala-headshot.png" alt="" width="44" height="44" />
        <span><b>蔡莎拉</b>　永慶不動產　近 20 年在地經驗</span>
      </div>
    </div>
  </div>

  <MapTool />
  <AffordTool />
  <LoanTool />
  <UnitPriceTool />
  <CapgainTool />

  <div class="closing">
    <div class="container closing-inner">
      <h2>算完了，想聊聊你的狀況？</h2>
      <p>數字只是起點。想知道哪一案適合你、能貸多少、什麼時候賣最划算，直接跟我聊。</p>
      <div class="closing-btns">
        <a class="btn btn-primary" href="https://line.me/ti/p/@saLa193" target="_blank" rel="noopener">LINE 問蔡莎拉</a>
        <a class="btn btn-outline-light" href="tel:0986793193">📞 0986-793-193</a>
      </div>
    </div>
  </div>
</BaseLayout>
