---
const navItems = [
  { href: '/', label: '工具首頁' },
  { href: '/map', label: '鳳鳴生活地圖' },
  { href: '/afford', label: '購屋能力試算' },
  { href: '/loan', label: '房貸月付金試算' },
  { href: '/capgain', label: '房地合一稅試算' },
  { href: 'https://www.salahome.tw/find', label: '找房子', external: true },
  { href: 'https://www.salahome.tw', label: '蔡莎拉官網', external: true },
];
// 正式部署的路徑可能帶結尾斜線，統一去掉再比對
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<div class="header-utility">
  <div class="container">
    <a href="tel:0986793193">📞 0986-793-193</a>
    <div class="social-icons">
      <a class="social-icon social-fb" href="https://www.facebook.com/0986793193s/" target="_blank" rel="noopener" aria-label="蔡莎拉 Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.5-3.5h-3V7.8c0-1 .3-1.7 1.7-1.7H16.6V3.1C16.3 3 15.3 3 14.2 3c-2.4 0-4 1.5-4 4.1V10H7.7v3.5h2.5V21h3.3z"/></svg>
      </a>
      <a class="social-icon social-yt" href="https://www.youtube.com/@SaLa193yt/videos" target="_blank" rel="noopener" aria-label="蔡莎拉 YouTube">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM10 15.3V8.7L15.8 12 10 15.3z"/></svg>
      </a>
      <a class="social-icon social-line" href="https://line.me/ti/p/@saLa193" target="_blank" rel="noopener" aria-label="蔡莎拉 LINE">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.4 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1 1c0 .3-.2 1.1 1 .6 1.1-.5 6.1-3.6 8.4-6.2C22.1 14 22 12.6 22 11c0-4.4-4.5-8-10-8z"/></svg>
      </a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/brand/sala-logo-horizontal.png" alt="蔡莎拉的工具箱｜鶯歌．鳳鳴不動產 × 土地廠房顧問" />
    </a>
    <div class="header-right">
      <button class="menu-btn" id="nav-toggle" aria-label="開啟選單" aria-expanded="false" aria-controls="nav-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <a class="btn btn-gold" href="https://line.me/ti/p/@saLa193" target="_blank" rel="noopener">LINE諮詢</a>
    </div>
  </div>
  <nav class="nav-panel" id="nav-panel">
    <div class="nav-grid">
      {navItems.map((item) => (
        <a href={item.href} class={item.href === currentPath ? 'current' : ''}>{item.label}{item.external ? ' ↗' : ''}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  if (btn && panel) {
    btn.addEventListener('click', () => {
      const isOpen = panel.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
