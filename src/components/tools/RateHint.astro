---
// 填利率的欄位下面：現在的房貸利率行情（資料在 src/data/rate-news.json，每月 1 日更新）
import rateNews from '../../data/rate-news.json';

interface Props { inputId: string }
const { inputId } = Astro.props;

// 發布日期轉成「2026 年 7 月 27 日」
const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${y} 年 ${m} 月 ${d} 日`;
};
---
<div class="rate-hint">
  <p class="rate-hint-head">📊 現在的房貸利率行情<span>（{rateNews.month}整理）</span></p>
  <ul class="rate-hint-list">
    {rateNews.rates.map((r) => (
      <li>
        <span class="rate-hint-label">{r.label}</span>
        {r.fill ? (
          <button type="button" class="rate-chip" data-target={inputId} data-rate={String(r.fill)} title={`點一下，把 ${r.fill}% 填進利率欄`}>{r.text}</button>
        ) : (
          <strong class="rate-hint-text">{r.text}</strong>
        )}
        <span class="rate-hint-note">{r.note}</span>
      </li>
    ))}
  </ul>
  <p class="rate-hint-tip">點上面的利率，會直接填進「貸款利率」欄。各銀行公告的只是起跳利率，實際核貸利率依你的信用、收入、負債與房屋鑑價而定。</p>
  <p class="rate-hint-source">
    完整整理：<a href={rateNews.url} target="_blank" rel="noopener noreferrer">{rateNews.title}</a>
    <span>（{rateNews.source}・{fmtDate(rateNews.published)}發布，每月 1 日更新）</span>
  </p>
</div>

<script>
  // 點行情裡的利率，填進同一個計算機的利率欄（全站只綁一次）
  document.addEventListener('click', (e) => {
    const chip = (e.target as Element | null)?.closest?.('.rate-chip') as HTMLButtonElement | null;
    if (!chip) return;
    const input = document.getElementById(chip.dataset.target || '') as HTMLInputElement | null;
    if (!input) return;
    input.value = chip.dataset.rate || '';
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.focus({ preventScroll: true });
  });
</script>
