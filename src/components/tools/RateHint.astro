---
// 房屋貸款最下面：目前使用的利率欄（不顯眼）＋現在的房貸利率行情（可點）＋利率來源。
// 資料在 src/data/rate-news.json，每月 1 日更新；點行情的處理在 MortgageTool.astro。
import rateNews from '../../data/rate-news.json';

interface Props { defaultRate: number; defaultLabel: string }
const { defaultRate, defaultLabel } = Astro.props;

// 發布日期轉成「2026 年 7 月 27 日」
const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${y} 年 ${m} 月 ${d} 日`;
};
---
<div class="rate-hint mt-rate-block">
  <p class="rate-hint-head">📊 房貸利率行情<span>（{rateNews.month}整理）</span></p>
  <div class="mt-rate-row">
    <label for="mt-rate">目前使用的利率</label>
    <span class="mt-rate-input"><input type="number" id="mt-rate" inputmode="decimal" min="0" step="0.001" value={defaultRate} autocomplete="off" /> %</span>
    <span>（預設：{defaultLabel}，每月更新）</span>
  </div>
  <ul class="rate-hint-list">
    {rateNews.rates.map((r) => (
      <li>
        <span class="rate-hint-label">{r.label}</span>
        {r.fill ? (
          <button type="button" class="rate-chip" data-rate={String(r.fill)} title={`點一下，改用 ${r.fill}% 計算`}>{r.text}</button>
        ) : (
          <strong class="rate-hint-text">{r.text}</strong>
        )}
        <span class="rate-hint-note">{r.note}</span>
      </li>
    ))}
  </ul>
  <p class="rate-hint-tip">點利率，就會改用那個利率重算。各銀行公告的是起跳利率，實際核貸利率依你的條件而定。</p>
  <p class="rate-hint-source">
    利率來源：<a href={rateNews.url} target="_blank" rel="noopener noreferrer">{rateNews.title}</a>
    <span>（{rateNews.source}・{fmtDate(rateNews.published)}發布，每月 1 日更新）</span>
  </p>
</div>
