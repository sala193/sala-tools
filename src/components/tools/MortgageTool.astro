---
import LoanPanel from './LoanPanel.astro';
import AffordPanel from './AffordPanel.astro';
---
  <section class="tool" id="loan">
    <div class="container calc-wrap">
      <p class="tool-tag">買房前</p>
      <h2 class="tool-title">房貸與購屋能力試算</h2>
      <p class="tool-lead">
        貸多少、每月繳多少，跟「我買得起多少」放在一起算。預算和月付金一起看，才不會抓錯。
      </p>

      <div class="mtabs" role="tablist" aria-label="選擇計算方式">
        <button type="button" role="tab" class="mtab is-active" id="mt-tab-loan" aria-controls="mt-panel-loan" aria-selected="true">
          月付金試算<small>貸多少，每月繳多少</small>
        </button>
        <button type="button" role="tab" class="mtab" id="mt-tab-afford" aria-controls="mt-panel-afford" aria-selected="false">
          購屋能力<small>收入與自備款，買得起多少</small>
        </button>
      </div>

      <div class="mpanel" id="mt-panel-loan" role="tabpanel" aria-labelledby="mt-tab-loan">
        <LoanPanel />
      </div>
      <div class="mpanel" id="mt-panel-afford" role="tabpanel" aria-labelledby="mt-tab-afford" hidden>
        <AffordPanel />
      </div>
    </div>
  </section>

<script>
(() => {
  type Name = 'loan' | 'afford';
  const tab = (n: Name) => document.getElementById('mt-tab-' + n) as HTMLButtonElement;
  const panel = (n: Name) => document.getElementById('mt-panel-' + n) as HTMLElement;

  function select(n: Name) {
    for (const k of ['loan', 'afford'] as Name[]) {
      const on = k === n;
      tab(k).classList.toggle('is-active', on);
      tab(k).setAttribute('aria-selected', String(on));
      panel(k).hidden = !on;
    }
  }
  tab('loan').addEventListener('click', () => select('loan'));
  tab('afford').addEventListener('click', () => select('afford'));

  // 購屋能力算出來的可貸金額，一鍵帶到月付金分頁
  document.getElementById('af-to-loan')!.addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const setv = (id: string, v: string) => {
      const el = document.getElementById(id) as HTMLInputElement;
      el.value = v;
      el.dispatchEvent(new Event('input', { bubbles: true }));
    };
    setv('ln-in-amount', b.dataset.loan || '');
    setv('ln-in-rate', b.dataset.rate || '');
    const yr = document.querySelector('#ln-loan-form input[name="years"][value="' + b.dataset.years + '"]') as HTMLInputElement | null;
    yr?.click();
    select('loan');
    tab('loan').scrollIntoView({ block: 'start' });
  });

  // 舊網址 /afford（#afford）直接開在「購屋能力」分頁
  const fromHash = () => { if (location.hash === '#afford') select('afford'); };
  window.addEventListener('tool-open', fromHash);
  fromHash();
})();
</script>
